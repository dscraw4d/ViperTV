# ViperTV portable/public defaults
# Copy to .env (the included install scripts do this automatically).

# Host port used by the web UI, M3U, XMLTV and stream endpoints.
VIPERTV_PORT=8409

# IANA timezone. Examples: UTC, America/Toronto, America/Vancouver, Europe/London
TZ=UTC
VIPERTV_PLEX_AUTO_SYNC_TIMEZONE=UTC

# Usually leave blank. When blank, ViperTV builds URLs from the incoming request.
# Set this only if clients must use a specific externally reachable LAN/reverse-proxy URL.
VIPERTV_PUBLIC_BASE_URL=

# Persistence and scans
VIPERTV_BACKUP_KEEP=60
VIPERTV_AUTO_SCAN_HOURS=6
VIPERTV_PLEX_SYNC_PAGE_SIZE=500
VIPERTV_PLEX_AUTO_SYNC_DAYS=3
VIPERTV_PLEX_AUTO_SYNC_HOUR=7
VIPERTV_TVDB_REFRESH_DAYS=30

# Plex transcode request limits
VIPERTV_PLEX_MAX_VIDEO_BITRATE=20000
VIPERTV_PLEX_VIDEO_RESOLUTION=1920x1080

# Pluto FAST region. Common values: us, ca, gb, de, fr, it, es, au
VIPERTV_PLUTO_REGION=us
VIPERTV_PLUTO_NUMBER_OFFSET=1000
VIPERTV_PLUTO_AUTO_SYNC_HOURS=24

# Default is portable CPU/software encoding. Intel VAAPI can be enabled with the
# compose.intel-vaapi.yml overlay on compatible Linux hosts.
VIPERTV_DEFAULT_STREAM_PROFILE=software
VIPERTV_TRANSCODE_PRESET=veryfast
VIPERTV_VIDEO_BITRATE=5000k
VIPERTV_AUDIO_BITRATE=192k

# Shared/live stream tuning
VIPERTV_SHARED_STREAM_GRACE_SECONDS=15
VIPERTV_SHARED_STREAM_QUEUE_CHUNKS=24
VIPERTV_LIVE_PROBE_SIZE=131072
VIPERTV_LIVE_ANALYZE_US=250000
VIPERTV_HLS_SEGMENT_SECONDS=1

# Local media directory on the Docker HOST. Mounted read-only at /media.
# Linux example: /mnt/media
# Windows Docker Desktop example: D:/Media
VIPERTV_MEDIA_DIR=./media
